# ==============================================================================
# GitHub CodeRAG — Backend Environment Variables (.env)
# ==============================================================================

# Server & HTTP Configuration
PORT=8081

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=coderag
DB_USER=postgres
DB_PASSWORD=postgres
# (Or use direct full URL: SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/coderag)

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
EMBEDDING_MODEL=text-embedding-004
CHAT_MODEL=gemini-1.5-flash
GEMINI_DAILY_QUOTA=1500
GEMINI_QUOTA_ENABLED=true

# Qdrant Vector Database Configuration
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJhY2Nlc3MiOiJtIiwic3ViamVjdCI6ImFwaS1rZXk6ZThhMWRhNTMtNzQwMC00MzRiLTg4NWMtZWQ3MDM2NWJhYTc0In0.QlIDGe3QeV-gs-86aG7JC4iATLqrFVDAWEH4G232ehI
QDRANT_COLLECTION=code_chunks

# GitHub OAuth App Credentials (for user login)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# GitHub API Integration (optional PAT for 5,000 req/hour limit instead of 60)
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_API_TOKEN=
MAX_REPO_SIZE_MB=100
MAX_FILE_SIZE_MB=10

# Local Cache Storage Path for Cloned Repositories
REPO_STORAGE_PATH=./data/repos

# JWT Security & Session Cookie
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=604800
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
COOKIE_SESSION_ONLY=true

# Frontend & CORS Configuration
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Rate Limiting Guardrails
RATE_LIMIT_IMPORT_PER_HOUR=5
RATE_LIMIT_CHAT_PER_HOUR=30
RATE_LIMIT_INTELLIGENCE_PER_HOUR=15
